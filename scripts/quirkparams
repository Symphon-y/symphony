#!/usr/bin/env bash
# quirkparams: the kernel parameters this machine's firmware quirks need --
# `scripts/hwmatch --kind cmdline` under the name install-base-system calls
# (Phase 17, D-0076; one parser since Phase 19, D-0082).
#
# Usage: scripts/quirkparams
set -euo pipefail
exec "$(dirname "${BASH_SOURCE[0]}")/hwmatch" --kind cmdline
