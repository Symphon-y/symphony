#!/usr/bin/env bash
# update: the normal way to bring an already-installed machine up to the
# latest release tag.
#
# Usage: scripts/update check|apply
#   check  report whether a newer release tag exists, and what would change
#   apply  take a pre-update Btrfs snapshot, then reapply this repo in the
#          same order docs/runbooks/rebuild.md already documents
#
# The release ISO (Phase 10) only ever bootstraps a machine once; this is the
# ongoing path for everything after that -- a config-only change (no new
# package) currently gets no automatic snapshot the way a pacman transaction
# does via snap-pac (D-0011). apply() closes that gap: an unconditional
# `snapper create` runs before anything else, every time, so an update can
# never be less recoverable than a plain `pacman -S` already is.
set -euo pipefail

REPO_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
readonly REPO_ROOT
readonly STATE_DIR="${AUTARCHY_STATE:-$HOME/.local/state/autarchy}"
readonly CURRENT_FILE="$STATE_DIR/current-release"

readonly INSTALL_PACKAGES="${AUTARCHY_INSTALL_PACKAGES:-$REPO_ROOT/install/install-packages}"
readonly SYNC_SYSTEM="${AUTARCHY_SYNC_SYSTEM:-$REPO_ROOT/install/sync-system}"
readonly LINK_HOME="${AUTARCHY_LINK_HOME:-$REPO_ROOT/install/link-home}"
readonly ENABLE_USER_SERVICES="${AUTARCHY_ENABLE_USER_SERVICES:-$REPO_ROOT/install/enable-user-services}"
readonly MIGRATE="${AUTARCHY_MIGRATE:-$REPO_ROOT/scripts/migrate}"

trap 'printf "update: failed at line %s: %s -- the pre-update snapshot (if one was taken) is still there; see D-0008 to roll back\n" "$LINENO" "$BASH_COMMAND" >&2' ERR

die() {
  printf 'update: %s\n' "$*" >&2
  exit 1
}

usage() {
  echo "usage: update check|apply" >&2
  exit 2
}

current_release() {
  [[ -r $CURRENT_FILE ]] && cat "$CURRENT_FILE" || echo "(none)"
}

latest_release() {
  git -C "$REPO_ROOT" tag --list '20*.*.*' --sort=-v:refname | head -1
}

fetch() {
  git -C "$REPO_ROOT" fetch --tags --quiet origin
}

summarize() {
  local current=$1 latest=$2
  if [[ $current == "(none)" ]]; then
    echo "no release recorded yet; latest available is $latest"
  else
    echo "changed packages/migrations between $current and $latest:"
    git -C "$REPO_ROOT" diff --stat "$current..$latest" -- packages/ migrations/
  fi
}

check() {
  fetch
  local current latest
  current=$(current_release)
  latest=$(latest_release)
  [[ -n $latest ]] || die "no release tags found (git fetch --tags first?)"

  if [[ $current == "$latest" ]]; then
    echo "update: up to date ($current)"
  else
    echo "update: $current -> $latest"
    summarize "$current" "$latest"
  fi
}

# Only validates -- no side effects -- so this runs before anything
# destructive, same as the disk/working-tree checks above it.
preflight_branch() {
  local branch
  branch=$(git -C "$REPO_ROOT" rev-parse --abbrev-ref HEAD)
  # HEAD (detached) is the state right after autarchy-bootstrap clones at a
  # release tag -- moved onto main below, same as any other update.
  if [[ $branch != main && $branch != HEAD ]]; then
    die "on branch '$branch', not main -- switch to main before updating"
  fi
}

# Moves the repo onto main (from a detached-at-tag clone, or a no-op if
# already there) and fast-forwards it.
sync_repo_to_main() {
  git -C "$REPO_ROOT" checkout --quiet main
  git -C "$REPO_ROOT" pull --ff-only --quiet origin main
}

apply() {
  preflight_branch
  git -C "$REPO_ROOT" status --porcelain | grep -q . &&
    die "working tree has uncommitted changes -- commit or stash first"

  fetch
  local current latest
  current=$(current_release)
  latest=$(latest_release)
  [[ -n $latest ]] || die "no release tags found (git fetch --tags first?)"

  if [[ $current == "$latest" ]]; then
    echo "update: up to date ($current)"
    return 0
  fi

  echo "update: $current -> $latest"
  echo "==> taking a pre-update snapshot"
  sudo snapper -c root create --description "pre-update: $current -> $latest"

  echo "==> updating the repo"
  sync_repo_to_main

  echo "==> installing packages"
  "$INSTALL_PACKAGES"
  echo "==> applying system config"
  sudo "$SYNC_SYSTEM" apply
  echo "==> applying home config"
  "$LINK_HOME" apply
  echo "==> enabling user services"
  "$ENABLE_USER_SERVICES" apply
  echo "==> running pending migrations"
  "$MIGRATE" apply

  mkdir -p "$STATE_DIR"
  echo "$latest" >"$CURRENT_FILE"
  echo "update: now at $latest"
}

main() {
  case ${1:-} in
    check | apply) "$1" ;;
    *) usage ;;
  esac
}

main "$@"
