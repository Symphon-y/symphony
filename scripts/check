#!/usr/bin/env bash
# check: static analysis and unit tests. The single entry point used locally and by CI.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

# Everything below is shell unless its shebang says otherwise: a Python script
# living among the shell ones (home/network/dot-local/bin/network-picker) is
# syntax-checked with the GUI's Python instead of handed to shellcheck.
shell_files=()
python_files=()
while IFS= read -r file; do
  if [[ $(head -n1 "$file") == '#!/usr/bin/env python3' ]]; then
    python_files+=("$file")
  else
    shell_files+=("$file")
  fi
done < <(
  # Everything under scripts/ and install/ is shell unless it is Lua: install/seed holds
  # templates the user ends up owning, and each is still in a language something checks --
  # the Lua ones by the luac step below, install/seed/bashrc by shellcheck like any other
  # shell file. Excluding the whole seed directory would silently drop that one.
  find scripts install -type f -not -name '*.lua' | sort
  find home -path '*/dot-local/bin/*' -type f -not -path '*/__pycache__/*' | sort
  find migrations -name '*.sh' -type f 2>/dev/null | sort
  find iso/profile/airootfs -type f -path '*/bin/*' 2>/dev/null | sort
  printf '%s\n' iso/build-offline-repo iso/build-in-container iso/profile/airootfs/root/.bash_profile
  printf '%s\n' system/*/*.sh tests/helpers/*.bash tests/unit/*.bats tests/acceptance/*.bats
  printf '%s\n' home/bash/dot-config/bash/symphony.bash
  printf '%s\n' gui/fake-backend
)

echo "==> shellcheck"
shellcheck -x "${shell_files[@]}"

echo "==> shfmt"
shfmt -d "${shell_files[@]}"

echo "==> JSON syntax"
while IFS= read -r json; do
  jq empty "$json"
done < <(find home system -name '*.json')

echo "==> YAML syntax"
while IFS= read -r yaml; do
  yq '.' "$yaml" >/dev/null
done < <(find .github/workflows -name '*.yml' 2>/dev/null)

echo "==> identifiers"
scripts/check-identifiers

echo "==> python syntax"
find gui -name '*.py' -print0 | xargs -0 python3 -m py_compile
# ast.parse, not py_compile: the latter always writes a __pycache__ beside the
# file, which would then be stow-linked into ~/.local/bin and shellchecked.
python3 -c 'import ast, sys
for path in sys.argv[1:]:
    with open(path, encoding="utf-8") as f:
        ast.parse(f.read(), path)' "${python_files[@]}"

echo "==> lua syntax"
# Hyprland's config is Lua, and a syntax error there costs a session -- the compositor
# comes up with no binds at all. luac -p parses without executing; -o /dev/null because
# luac writes luac.out otherwise. Same idea as the ast.parse step above.
find home install/seed -name '*.lua' -print0 | xargs -0 luac -p -o /dev/null

echo "==> gui: unit tests"
python3 -m unittest discover -s gui/tests -t gui

echo "==> unit tests"
bats tests/unit
