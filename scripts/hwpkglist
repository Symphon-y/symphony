#!/usr/bin/env bash
# hwpkglist: the extra packages this machine's hardware needs -- `scripts/hwmatch
# --kind packages` under the name install-base-system and symphony-update call
# (Phase 17, D-0074; one parser since Phase 19, D-0082).
#
# Usage: scripts/hwpkglist
set -euo pipefail
exec "$(dirname "${BASH_SOURCE[0]}")/hwmatch" --kind packages
