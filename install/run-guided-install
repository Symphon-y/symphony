#!/usr/bin/env bash
# run-guided-install: the shared runner both the terminal collector
# (symphony-install) and the GTK4 GUI (Phase 15) hand off to, so neither
# has to reimplement "run the install, then offer to reboot."
#
# Usage: install/run-guided-install [--no-reboot-prompt] VARS_FILE
#   --no-reboot-prompt  skip the interactive "Reboot now? [Y/n]" prompt
#                        and just return after a successful install. For
#                        the GUI, which has no terminal a user is
#                        watching -- read -rp would hang, or worse,
#                        silently take the EOF-default branch. The GUI
#                        shows its own Reboot/Stay UI instead, calling
#                        install/finish-install itself on "Reboot."
#   VARS_FILE  per-install values, already written by whichever collector
#              is running (install/base-install.vars.example)
#
# No install logic here -- see install/install-base-system, the real,
# already-tested, unattended installer this just execs. If fd 8 (user
# account password) and/or fd 9 (LUKS passphrase) are open on this
# process, they're inherited automatically; this script doesn't need to
# touch either itself -- see install-base-system's and
# configure-base-system's own headers for the fd-8/fd-9 contract.
set -euo pipefail

REPO_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
readonly REPO_ROOT
readonly INSTALL_SCRIPT="${SYMPHONY_INSTALL_SCRIPT:-$REPO_ROOT/install/install-base-system}"
readonly FINISH_SCRIPT="${SYMPHONY_FINISH_SCRIPT:-$REPO_ROOT/install/finish-install}"

usage() {
  echo "usage: run-guided-install [--no-reboot-prompt] VARS_FILE" >&2
  exit 2
}

main() {
  local no_reboot_prompt=0
  if [[ ${1:-} == --no-reboot-prompt ]]; then
    no_reboot_prompt=1
    shift
  fi
  (($# == 1)) || usage
  local vars_file=$1

  "$INSTALL_SCRIPT" "$vars_file"

  echo
  echo "==> Base install done."
  if ((no_reboot_prompt)); then
    return 0
  fi

  local next
  read -rp "Reboot now? [Y/n] " next
  if [[ ! $next =~ ^[Nn]$ ]]; then
    "$FINISH_SCRIPT"
  else
    echo "Staying at the shell. When ready: umount -R /mnt; cryptsetup close root; poweroff"
  fi
}

main "$@"
