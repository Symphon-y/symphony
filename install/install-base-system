#!/usr/bin/env bash
# install-base-system: partition, encrypt, format, and pacstrap a fresh disk,
# then hand off to configure-base-system (runbook step 6).
#
# Usage: install/install-base-system VARS_FILE [TARGET]
#   VARS_FILE  per-install values (docs/runbooks/base-install.vars.example)
#   TARGET     where the new system is mounted (default: /mnt)
#
# Covers base-install.md steps 4-5 (partition/LUKS/Btrfs/ESP/pacstrap/fstab),
# then runs configure-base-system (step 6) as its last step. Driven entirely
# by the vars file and system/storage/{layout.conf,subvolumes.txt}. The one
# interactive moment that's always present is a destructive-action
# confirmation before $DISK is touched (typing the disk path back, not
# just y/n). The root LUKS passphrase (Phase 15) is a second, optional
# interactive moment -- optional because it can instead be supplied by the
# caller via file descriptor 9 (the typed-and-confirmed passphrase from
# whichever collector is running, terminal or GUI), in which case
# encryption runs unattended too. fd 8, if open, is never read here --
# it's simply inherited through to configure-base-system, which uses it
# the same way for the user account password (see that script's own
# header). Collect-once-then-run-unattended, the same shape Windows/
# macOS installers use (Phase 10), built our own way: no archinstall,
# no TUI, no Omarchy code.
set -Eeuo pipefail

REPO_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
readonly REPO_ROOT
readonly CONFIGURE_SCRIPT="${SYMPHONY_CONFIGURE_SCRIPT:-$REPO_ROOT/install/configure-base-system}"
readonly HWPKGLIST="${SYMPHONY_HWPKGLIST_SCRIPT:-$REPO_ROOT/scripts/hwpkglist}"
readonly QUIRKPARAMS="${SYMPHONY_QUIRKPARAMS_SCRIPT:-$REPO_ROOT/scripts/quirkparams}"

# Packages this machine's hardware needs on top of packages/*.txt (Phase 17); filled in by
# resolve_hardware_packages before anything destructive happens.
HARDWARE_PACKAGES=()

# Kernel parameters this machine's firmware quirks need (D-0076), space-separated; filled in by
# resolve_kernel_params and handed to configure-base-system, which puts them on the boot command line.
KERNEL_PARAMS=""

readonly REQUIRED_VARS=(DISK HOST USERNAME TZONE LOCALE KEYMAP)
# SWAP_SIZE is optional (Phase 12): unset means zram-only, unchanged from
# today. When set, these name the generated hibernation-swap keyfile.
readonly SWAP_MAPPER=cryptswap
# Named after $SWAP_MAPPER, not arbitrarily: crypttab(5)'s automatic
# per-device keyfile discovery (a keyfile named after the mapper,
# suffixed .key, under /etc/cryptsetup-keys.d/) is what lets sd-encrypt
# find this key from inside the initramfs when configure-base-system
# unlocks this device early via rd.luks.name= -- no separate
# rd.luks.key= cmdline parameter needed.
readonly SWAP_KEYFILE=/etc/cryptsetup-keys.d/$SWAP_MAPPER.key
trap 'printf "install-base-system: failed at line %s: %s\n" "$LINENO" "$BASH_COMMAND" >&2' ERR

log() {
  printf '==> %s\n' "$*"
}

die() {
  printf 'install-base-system: %s\n' "$*" >&2
  exit 1
}

usage() {
  echo "usage: install-base-system VARS_FILE [TARGET]" >&2
  exit 2
}

load_config() {
  local vars_file=$1 name
  [[ -r $vars_file ]] || die "cannot read vars file '$vars_file'"

  # shellcheck source-path=SCRIPTDIR source=../system/storage/layout.conf
  source "$REPO_ROOT/system/storage/layout.conf"
  # shellcheck disable=SC1090 # per-install file, chosen at runtime
  source "$vars_file"

  for name in "${REQUIRED_VARS[@]}"; do
    [[ -n ${!name:-} ]] || die "$name is not set in $vars_file"
  done
}

# Every check goes through lsblk so it can be stubbed the same way in tests
# as every other external command here -- [[ -b ... ]] is a shell builtin
# and can't be.
preflight() {
  (($(id -u) == 0)) || die "must run as root"
  [[ $(lsblk -dno TYPE "$DISK" 2>/dev/null) == disk ]] || die "'$DISK' is not a block device"
  mountpoint -q "$TARGET" && die "$TARGET is already mounted -- unmount before running this"
  local mounted
  mounted=$(lsblk -no MOUNTPOINT "$DISK" 2>/dev/null | grep -c . || true)
  ((mounted == 0)) || die "'$DISK' has a mounted partition -- unmount it first"
}

# Which extra packages the PCI devices on this machine need (system/hardware.txt, e.g.
# the proprietary driver for a Broadcom BCM4352 Wi-Fi chip). Resolved up front, with the
# other checks: a broken map must stop the install before the disk is touched, and a
# failure inside `mapfile < <(...)` would be silent, hence the command substitution.
resolve_hardware_packages() {
  local output
  output=$("$HWPKGLIST")
  [[ -z $output ]] || mapfile -t HARDWARE_PACKAGES <<<"$output"
  if ((${#HARDWARE_PACKAGES[@]} > 0)); then
    log "This machine's hardware needs: ${HARDWARE_PACKAGES[*]}"
  fi
}

# Which kernel parameters this machine's firmware quirks need (system/hardware.txt, e.g.
# module_blacklist=dell_rbtn on the Alienware 14). Resolved up front for the same reason as
# the hardware packages: a broken map stops the install before the disk is touched.
resolve_kernel_params() {
  local output
  output=$("$QUIRKPARAMS")
  [[ -z $output ]] || KERNEL_PARAMS=$(tr '\n' ' ' <<<"$output")
  KERNEL_PARAMS=${KERNEL_PARAMS% }
  if [[ -n $KERNEL_PARAMS ]]; then
    log "This machine's firmware needs kernel parameters: $KERNEL_PARAMS"
  fi
}

# The one interactive moment: typing the disk path back, not just y/n, so a
# reflexive Enter can't confirm the wrong disk.
confirm_destructive() {
  log "This will ERASE EVERYTHING on $DISK and partition it for symphony."
  local reply
  read -rp "Type the disk path ($DISK) to continue: " reply
  [[ $reply == "$DISK" ]] || die "confirmation did not match '$DISK', aborting"
}

partition_disk() {
  log "Partitioning $DISK"
  sgdisk --zap-all "$DISK"
  if [[ -n ${SWAP_SIZE:-} ]]; then
    sgdisk -n "1:0:+$ESP_SIZE" -t 1:ef00 -c "1:$ESP_PARTLABEL" \
      -n "2:0:+$SWAP_SIZE" -t 2:8309 -c "2:$SWAP_PARTLABEL" \
      -n 3:0:0 -t 3:8309 -c "3:$LUKS_PARTLABEL" "$DISK"
  else
    sgdisk -n "1:0:+$ESP_SIZE" -t 1:ef00 -c "1:$ESP_PARTLABEL" \
      -n 2:0:0 -t 2:8309 -c "2:$LUKS_PARTLABEL" "$DISK"
  fi
  partprobe "$DISK"
  udevadm settle
}

subvolumes() {
  grep -Ev '^[[:space:]]*(#|$)' "$REPO_ROOT/system/storage/subvolumes.txt"
}

encrypt_and_format() {
  local esp_dev="/dev/disk/by-partlabel/$ESP_PARTLABEL"
  local luks_dev="/dev/disk/by-partlabel/$LUKS_PARTLABEL"
  local subvol mountpoint passphrase

  log "Encrypting $luks_dev"
  # fd 9, when open, carries the typed-and-confirmed root passphrase from
  # whichever collector is running (the terminal fallback or the future
  # GUI) -- never the vars file, never disk (Phase 15/D-0066). Not fd 3:
  # bats-core itself holds fd 3 (and 4, 5) open internally for its own
  # output capture, so `[[ -e /dev/fd/3 ]]` is true even when no test
  # provides one -- confirmed live, not assumed. fd 9 is the standard
  # "app-specific, unlikely to collide" choice for exactly this reason.
  # Read once into a variable, not `--key-file /dev/fd/9` directly:
  # cryptsetup runs twice here (format, then open), and a second read
  # from the same fd would just get EOF -- the underlying file offset is
  # shared once a fd is inherited, it isn't reset per process. Falls back
  # to cryptsetup's own interactive prompt (today's exact behavior) when
  # fd 9 isn't open, so the documented manual/recovery runbook path
  # (base-install.md), which calls this script directly with no
  # collector at all, stays unaffected.
  if [[ -e /dev/fd/9 ]]; then
    read -r passphrase <&9
    printf '%s' "$passphrase" | cryptsetup luksFormat --type luks2 --key-file - "$luks_dev"
    printf '%s' "$passphrase" | cryptsetup open --allow-discards --persistent --key-file - "$luks_dev" "$LUKS_MAPPER"
  else
    cryptsetup luksFormat --type luks2 "$luks_dev"
    cryptsetup open --allow-discards --persistent "$luks_dev" "$LUKS_MAPPER"
  fi

  log "Creating Btrfs subvolumes"
  mkfs.btrfs -L "$BTRFS_LABEL" "/dev/mapper/$LUKS_MAPPER"
  mount "/dev/mapper/$LUKS_MAPPER" /mnt
  while read -r subvol mountpoint; do
    btrfs subvolume create "/mnt/$subvol"
  done < <(subvolumes)
  umount /mnt

  while read -r subvol mountpoint; do
    mount --mkdir -o "$BTRFS_MOUNT_OPTS,subvol=$subvol" \
      "/dev/mapper/$LUKS_MAPPER" "$TARGET$mountpoint"
  done < <(subvolumes)

  log "Formatting the ESP"
  mkfs.fat -F 32 -n ESP "$esp_dev"
  # -t vfat explicit, not auto-detected: a real hardware install hit
  # "unknown parameter 'fmask'" without it -- modern util-linux's newer
  # mount API can fail to route FAT-specific options correctly when the
  # filesystem type isn't given upfront, even though fmask/dmask are
  # standard, well-supported vfat options.
  mount --mkdir -t vfat -o fmask=0077,dmask=0077 "$esp_dev" "$TARGET$ESP_MOUNT"
}

install_packages_and_fstab() {
  log "Installing packages (pacstrap)"
  local packages=()
  mapfile -t packages < <("$REPO_ROOT/scripts/pkglist" "$REPO_ROOT"/packages/*.txt)
  packages+=("${HARDWARE_PACKAGES[@]}")
  # -M: don't copy the live ISO's own (nonexistent/blank) mirrorlist into
  # the installed system -- leaves the target to use its own freshly-
  # pacstrap'd pacman-mirrorlist package's template instead.
  pacstrap -K -M "$TARGET" "${packages[@]}"

  # `>` not `>>`: re-running this must not duplicate every fstab entry.
  genfstab -U "$TARGET" >"$TARGET/etc/fstab"
  # Mount by subvolume name only: subvolid= would pin the IDs and break rollback.
  sed -i 's/subvolid=[0-9]*,//g' "$TARGET/etc/fstab"
}

# Hibernation-capable swap (Phase 12): a generated random keyfile, not a
# memorized passphrase -- swap holds no data worth a typed secret, only
# encryption-at-rest, unlocked automatically at boot via the copy embedded
# in the initramfs (system/mkinitcpio's FILES=, written below). Runs after
# install_packages_and_fstab: the keyfile and crypttab/fstab entries need
# $TARGET/etc, which pacstrap creates, and genfstab overwrites fstab with
# `>`, so this must come after genfstab too. No-op unless SWAP_SIZE is set.
configure_swap() {
  [[ -n ${SWAP_SIZE:-} ]] || return 0

  local swap_dev="/dev/disk/by-partlabel/$SWAP_PARTLABEL" swap_uuid

  log "Setting up encrypted swap for hibernation"
  install -d -m 0700 "$TARGET$(dirname "$SWAP_KEYFILE")"
  dd if=/dev/urandom of="$TARGET$SWAP_KEYFILE" bs=4096 count=1 status=none
  chmod 0600 "$TARGET$SWAP_KEYFILE"

  cryptsetup luksFormat --type luks2 --batch-mode --key-file "$TARGET$SWAP_KEYFILE" "$swap_dev"
  cryptsetup open --key-file "$TARGET$SWAP_KEYFILE" "$swap_dev" "$SWAP_MAPPER"
  mkswap "/dev/mapper/$SWAP_MAPPER"

  swap_uuid=$(blkid -s UUID -o value "$swap_dev")
  # x-initrd.attach: configure-base-system's rd.luks.name= does the real
  # unlock early, inside the initramfs (required for resume= to work at
  # all -- a real boot deadlock otherwise, see D-0065). This crypttab
  # entry's job becomes correct shutdown ordering (detaching cleanly),
  # not the unlock itself -- crypttab(5)'s documented option for exactly
  # this "also used in the initrd" case.
  echo "$SWAP_MAPPER UUID=$swap_uuid $SWAP_KEYFILE luks,x-initrd.attach" >>"$TARGET/etc/crypttab"
  echo "/dev/mapper/$SWAP_MAPPER none swap defaults 0 0" >>"$TARGET/etc/fstab"

  mkdir -p "$TARGET/etc/mkinitcpio.conf.d"
  echo "FILES=($SWAP_KEYFILE)" >"$TARGET/etc/mkinitcpio.conf.d/20-swap-resume.conf"
}

main() {
  (($# >= 1 && $# <= 2)) || usage
  local vars_file=$1
  TARGET=${2:-/mnt}

  load_config "$vars_file"
  preflight
  resolve_hardware_packages
  resolve_kernel_params
  confirm_destructive

  partition_disk
  encrypt_and_format
  install_packages_and_fstab
  configure_swap

  log "Base disk layout done. Handing off to configure-base-system."
  if [[ -n ${SWAP_SIZE:-} ]]; then
    export SYMPHONY_RESUME_DEVICE="/dev/mapper/$SWAP_MAPPER"
  fi
  if [[ -n $KERNEL_PARAMS ]]; then
    export SYMPHONY_KERNEL_PARAMS="$KERNEL_PARAMS"
  fi
  "$CONFIGURE_SCRIPT" "$vars_file" "$TARGET"
}

main "$@"
