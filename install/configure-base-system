#!/usr/bin/env bash
# configure-base-system: configure a freshly pacstrapped autarchy system
# (runbook step 6).
#
# Usage: install/configure-base-system VARS_FILE [TARGET]
#   VARS_FILE  per-install values (docs/runbooks/base-install.vars.example)
#   TARGET     mounted root of the new system (default: /mnt)
#
# Runs from the live ISO, outside the chroot, so the repo's system/ files are at
# hand. Commands that must run inside the new system go through arch-chroot.
# Every input is validated before anything changes. Safe to re-run: steps that
# are already done (user account, boot loader) are skipped, and every other step
# rewrites the same result.
#
# fd 8, when open on this process (inherited from install-base-system,
# which itself just inherits it from whichever collector is running --
# never touched or read in between), carries the typed-and-confirmed
# user account password -- same contract as install-base-system's own
# fd 9 for the LUKS passphrase (Phase 15/D-0066). Falls back to
# `passwd`'s own interactive prompt when fd 8 isn't open.
#
# Phase 16 (fully automated desktop bring-up): also gives the new user a
# real, permanent git checkout of this repo, links their dotfiles against
# it, enables+autologins SDDM, and writes ~/.gitconfig.local when the
# collector gathered a git identity (GIT_NAME/GIT_EMAIL, both optional).
# Enabling *user*-level services (notifications, idle/lock, wallpaper,
# polkit agent, bar, clipboard) can't happen here -- systemctl --user
# needs a live session this chroot doesn't have -- see install/first-login,
# triggered once from the desktop's own Hyprland config instead.
set -Eeuo pipefail

REPO_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
readonly REPO_ROOT

readonly REQUIRED_VARS=(HOST USERNAME TZONE LOCALE KEYMAP)

readonly SERVICES=(
  NetworkManager.service
  systemd-resolved.service
  systemd-timesyncd.service
  nftables.service
  systemd-boot-update.service
  fstrim.timer
  paccache.timer
  sddm.service
)

trap 'printf "configure-base-system: failed at line %s: %s\n" "$LINENO" "$BASH_COMMAND" >&2' ERR

log() {
  printf '==> %s\n' "$*"
}

die() {
  printf 'configure-base-system: %s\n' "$*" >&2
  exit 1
}

usage() {
  echo "usage: configure-base-system VARS_FILE [TARGET]" >&2
  exit 2
}

in_target() {
  arch-chroot "$TARGET" "$@"
}

# Install the root-owned files from system/files.txt into the target.
sync_system_files() {
  "$REPO_ROOT/install/sync-system" --root "$TARGET" apply
}

load_config() {
  local vars_file=$1 name
  [[ -r $vars_file ]] || die "cannot read vars file '$vars_file'"

  # shellcheck source-path=SCRIPTDIR source=../system/storage/layout.conf
  source "$REPO_ROOT/system/storage/layout.conf"
  # shellcheck disable=SC1090 # per-install file, chosen at runtime
  source "$vars_file"

  for name in "${REQUIRED_VARS[@]}"; do
    [[ -n ${!name:-} ]] || die "$name is not set in $vars_file"
  done
}

# locale.gen lists every locale commented out, as "#<locale> <charset>".
locale_is_listed() {
  awk -v locale="$LOCALE" '
    { name = $1; sub(/^#/, "", name) }
    name == locale { found = 1 }
    END { exit !found }
  ' "$TARGET/etc/locale.gen"
}

preflight() {
  (($(id -u) == 0)) || die "must run as root"
  mountpoint -q "$TARGET" || die "$TARGET is not mounted"
  mountpoint -q "$TARGET$ESP_MOUNT" || die "$TARGET$ESP_MOUNT is not mounted"
  [[ -s $TARGET/etc/fstab ]] || die "$TARGET/etc/fstab is missing or empty: run pacstrap and genfstab first"
  [[ -e $TARGET/usr/share/zoneinfo/$TZONE ]] || die "unknown timezone '$TZONE'"
  locale_is_listed || die "locale '$LOCALE' is not listed in $TARGET/etc/locale.gen"
}

install_system_files() {
  log "Installing system configuration files"
  sync_system_files
}

# Uncomment exactly the chosen locale; examples and other locales stay commented.
enable_locale() {
  local file="$TARGET/etc/locale.gen" edited
  edited=$(awk -v locale="$LOCALE" '
    { name = $1; sub(/^#/, "", name); if (name == locale) sub(/^#/, "") }
    { print }
  ' "$file")
  printf '%s\n' "$edited" >"$file"
}

configure_identity() {
  log "Setting timezone, locale, keymap, and hostname"
  ln -sf "/usr/share/zoneinfo/$TZONE" "$TARGET/etc/localtime"
  in_target hwclock --systohc
  enable_locale
  in_target locale-gen
  echo "LANG=$LOCALE" >"$TARGET/etc/locale.conf"
  # Written before the UKIs are built: sd-vconsole bakes the keymap into the initramfs.
  echo "KEYMAP=$KEYMAP" >"$TARGET/etc/vconsole.conf"
  echo "$HOST" >"$TARGET/etc/hostname"
}

configure_boot() {
  log "Building unified kernel images and installing systemd-boot"
  local luks_device="/dev/disk/by-partlabel/$LUKS_PARTLABEL" luks_uuid
  luks_uuid=$(blkid -s UUID -o value "$luks_device" || true)
  [[ -n $luks_uuid ]] || die "cannot read the UUID of $luks_device"

  # rootflags names the @ subvolume, the first entry in system/storage/subvolumes.txt.
  local cmdline="rd.luks.name=$luks_uuid=$LUKS_MAPPER root=/dev/mapper/$LUKS_MAPPER rootflags=subvol=@ rw"
  # Hibernation (Phase 12): set only when install-base-system configured a
  # dedicated swap mapper. Baked in explicitly rather than relying on
  # systemd's EFI-variable auto-detect, which has known rough edges on some
  # firmware and isn't needed for a plain partition.
  #
  # resume= alone is not enough (D-0065, a real boot deadlock found on
  # real hardware): systemd-hibernate-resume.service runs *inside the
  # initramfs*, before the real root is even mounted, and binds to the
  # resume device's unit. A device only unlocked later via /etc/crypttab
  # (which lives on the not-yet-mounted real root) can never satisfy
  # that -- a permanent hang, not a slow one (JobTimeoutSec=infinity
  # when resume= comes from the kernel cmdline and no
  # x-systemd.device-timeout is set, hence resumeflags= below too). The
  # swap device needs its own rd.luks.name=, exactly like root already
  # has, so sd-encrypt unlocks it early, inside the initramfs, before
  # systemd-hibernate-resume.service needs it.
  if [[ -n ${AUTARCHY_RESUME_DEVICE:-} ]]; then
    local swap_mapper swap_device swap_uuid
    swap_mapper=$(basename "$AUTARCHY_RESUME_DEVICE")
    swap_device="/dev/disk/by-partlabel/$SWAP_PARTLABEL"
    swap_uuid=$(blkid -s UUID -o value "$swap_device" || true)
    [[ -n $swap_uuid ]] || die "cannot read the UUID of $swap_device"
    cmdline+=" rd.luks.name=$swap_uuid=$swap_mapper resume=$AUTARCHY_RESUME_DEVICE resumeflags=x-systemd.device-timeout=30s"
  fi
  mkdir -p "$TARGET/etc/kernel"
  echo "$cmdline" >"$TARGET/etc/kernel/cmdline"

  # pacstrap built separate initramfs images with the stock presets; UKIs replace them.
  rm -f "$TARGET"/boot/initramfs-*.img
  mkdir -p "$TARGET$ESP_MOUNT/EFI/Linux"
  in_target mkinitcpio -P

  if ! in_target bootctl is-installed >/dev/null 2>&1; then
    in_target bootctl install
  fi
  # bootctl install may write its own default loader.conf; apply again so ours wins.
  sync_system_files
}

create_user() {
  log "Creating user $USERNAME and locking root"
  if ! in_target id -u "$USERNAME" >/dev/null 2>&1; then
    in_target useradd -m -G wheel "$USERNAME"
  fi
  # A new account starts locked (L). Set a usable password (P) if one isn't
  # set yet. fd 8 (see header) lets this run unattended via chpasswd --
  # the standard, non-interactive way to set a Linux password; passwd(1)
  # itself has no such mode on shadow-utils. Without fd 8, falls back to
  # passwd's own interactive prompt, so a mistyped password can still be
  # retried by re-running the script.
  if [[ $(in_target passwd -S "$USERNAME" | awk '{ print $2 }') != P ]]; then
    if [[ -e /dev/fd/8 ]]; then
      local user_password
      read -r user_password <&8
      printf '%s:%s' "$USERNAME" "$user_password" | in_target chpasswd
    else
      in_target passwd "$USERNAME"
    fi
  fi
  in_target passwd -l root
}

# Gives the new user a real, permanent git checkout of this repo (not a
# plain file copy): $REPO_ROOT here is the live ISO's own baked-in copy
# (Phase 14), which now includes .git (release-iso.yml no longer excludes
# it -- 2.7 MB, measured). Without this, install/link-home's stow symlinks
# would point into the live ISO's ephemeral squashfs, broken the instant
# the real system boots without it. scripts/update already has a test for
# exactly this shape (a detached-HEAD checkout it moves onto main), so
# this completes something already anticipated, not a new coupling.
copy_repo() {
  log "Copying the repo to ~$USERNAME/Projects/autarchy"
  local dest="$TARGET/home/$USERNAME/Projects/autarchy"
  mkdir -p "$(dirname "$dest")"
  cp -a "$REPO_ROOT" "$dest"
  in_target chown -R "$USERNAME:$USERNAME" "/home/$USERNAME/Projects/autarchy"
}

# stow needs no live session, just a writable $HOME -- safe to run here,
# unlike enable_user_services below (see install/first-login).
#
# useradd -m (create_user, above) populates the new home from /etc/skel,
# which ships .bash_logout/.bash_profile/.bashrc -- home/bash/dot-bashrc
# stows over exactly .bashrc, and GNU stow aborts its entire combined
# call (every package, not just bash) on a single conflict like that
# (reproduced live: a real hardware install got this far, crashed here
# under set -Eeuo pipefail, and never reached enable_services() below --
# the disk/boot loader/user account were already done, so it still
# booted, just straight to a bare TTY, no SDDM). Removing the skel files
# first is safe only here: the account was created one step ago and is
# certain to hold nothing but stock skel content. install/link-home
# itself stays untouched -- it's also run by hand against already-
# customized machines (rebuild.md), where this same removal would be
# destructive.
link_home() {
  log "Linking dotfiles for $USERNAME"
  rm -f "$TARGET/home/$USERNAME"/.bash_logout \
    "$TARGET/home/$USERNAME"/.bash_profile \
    "$TARGET/home/$USERNAME"/.bashrc
  in_target runuser -u "$USERNAME" -- bash -c "cd /home/$USERNAME/Projects/autarchy && install/link-home apply"
}

# D-0026 adopted SDDM but deliberately left autologin unconfigured; Phase
# 16 reverses that part of the choice (user confirmed) -- LUKS is already
# the real gate at boot. hyprland-uwsm is the exact session name Hyprland's
# own package ships (confirmed by reading
# /usr/share/wayland-sessions/hyprland-uwsm.desktop directly, not guessed).
configure_autologin() {
  log "Configuring SDDM autologin for $USERNAME"
  mkdir -p "$TARGET/etc/sddm.conf.d"
  cat >"$TARGET/etc/sddm.conf.d/20-autologin.conf" <<EOF
[Autologin]
User=$USERNAME
Session=hyprland-uwsm
EOF
}

# Completes a real, previously half-built feature: the GUI installer's
# Developer Identity page has collected git_name/git_email since Phase 15,
# but nothing ever wrote them anywhere until now. Both optional (GIT_NAME/
# GIT_EMAIL unset when skipped) -- only write the file when both are given.
# ~/.gitconfig.local is the untracked, machine-local half of D-0048's split
# (home/git/dot-gitconfig includes it); never a tracked file, so this never
# touches D-0022's no-identifiers rule.
write_git_identity() {
  [[ -n ${GIT_NAME:-} && -n ${GIT_EMAIL:-} ]] || return 0
  log "Writing git identity for $USERNAME"
  cat >"$TARGET/home/$USERNAME/.gitconfig.local" <<EOF
[user]
	name = $GIT_NAME
	email = $GIT_EMAIL
EOF
  in_target chown "$USERNAME:$USERNAME" "/home/$USERNAME/.gitconfig.local"
}

enable_services() {
  log "Enabling base services"
  systemctl --root="$TARGET" enable "${SERVICES[@]}"
}

# Last on purpose: arch-chroot bind-mounts the host's resolv.conf over this path
# while it runs.
link_resolv_conf() {
  log "Pointing resolv.conf at the systemd-resolved stub"
  ln -sf ../run/systemd/resolve/stub-resolv.conf "$TARGET/etc/resolv.conf"
}

main() {
  (($# >= 1 && $# <= 2)) || usage
  TARGET=${2:-/mnt}

  load_config "$1"
  preflight

  install_system_files
  configure_identity
  configure_boot
  create_user
  copy_repo
  link_home
  configure_autologin
  write_git_identity
  enable_services
  link_resolv_conf

  log "Done. Next (runbook step 7): umount -R $TARGET; cryptsetup close $LUKS_MAPPER; poweroff"
}

main "$@"
