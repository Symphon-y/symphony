#!/usr/bin/env bash
# configure-base-system: configure a freshly pacstrapped symphony system
# (runbook step 6).
#
# Usage: install/configure-base-system VARS_FILE [TARGET]
#   VARS_FILE  per-install values (install/base-install.vars.example)
#   TARGET     mounted root of the new system (default: /mnt)
#
# Runs from the live ISO, outside the chroot, so the repo's system/ files are at
# hand. Commands that must run inside the new system go through arch-chroot.
# Every input is validated before anything changes. Safe to re-run: steps that
# are already done (user account, boot loader) are skipped, and every other step
# rewrites the same result.
#
# fd 8, when open on this process (inherited from install-base-system,
# which itself just inherits it from whichever collector is running --
# never touched or read in between), carries the typed-and-confirmed
# user account password -- same contract as install-base-system's own
# fd 9 for the LUKS passphrase (Phase 15/D-0066). Falls back to
# `passwd`'s own interactive prompt when fd 8 isn't open.
#
# Phase 16 (fully automated desktop bring-up): also installs the OS payload
# (below), creates the user's XDG directories, links their dotfiles against
# the payload, creates snapper's root config, enables+autologins SDDM, and
# writes ~/.gitconfig.local when the collector gathered a git identity
# (GIT_NAME/GIT_EMAIL, both optional). Enabling *user*-level services
# (notifications, idle/lock, wallpaper, polkit agent, bar, clipboard) can't
# happen here -- systemctl --user needs a live session this chroot doesn't
# have -- see install/first-login, triggered once from the desktop's own
# Hyprland config instead.
#
# The installed machine gets no git checkout of this repo (a machine isn't a
# dev clone -- Windows has no "windows-os" repo either): install_payload puts
# just the OS content, root-owned, at a fixed path. Fixed, and a real
# directory rather than a symlink to a versioned one, on purpose: GNU stow
# records each symlink by the *resolved* path of its stow dir and refuses to
# restow over links into a different one (confirmed by trying it), so the
# path has to stay physically the same across future updates.
set -Eeuo pipefail

REPO_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
readonly REPO_ROOT
readonly ENABLE_ROOT_SERVICES="${SYMPHONY_ENABLE_ROOT_SERVICES_SCRIPT:-$REPO_ROOT/install/enable-root-services}"
# The live ISO's own release marker (baked in by release-iso.yml) -- absent on a
# plain stock-ISO manual install, which is recorded as "unreleased".
readonly LIVE_RELEASE_FILE="${SYMPHONY_LIVE_RELEASE_FILE:-/etc/symphony-release}"
# Where the live session's NetworkManager saves connections (Phase 17): the
# installer's Wi-Fi page, or nmtui from a shell, leaves one file per network.
readonly LIVE_NM_DIR="${SYMPHONY_LIVE_NM_DIR:-/etc/NetworkManager/system-connections}"

# What an installed machine needs from this repo. Not tests/, iso/, gui/ or
# docs/ (build-time or dev-time only), and never .git or the GUI's vars file
# that sits at the repo root: an allow-list means nothing else can leak in.
readonly PAYLOAD_ROOT=/usr/local/share/symphony
readonly PAYLOAD_DIR=$PAYLOAD_ROOT/current
readonly PAYLOAD_CONTENT=(home install migrations packages scripts system)

readonly REQUIRED_VARS=(HOST USERNAME TZONE LOCALE KEYMAP)

readonly SERVICES=(
  NetworkManager.service
  systemd-resolved.service
  systemd-timesyncd.service
  nftables.service
  systemd-boot-update.service
  fstrim.timer
  paccache.timer
  snapper-cleanup.timer
  sddm.service
)

trap 'printf "configure-base-system: failed at line %s: %s\n" "$LINENO" "$BASH_COMMAND" >&2' ERR

log() {
  printf '==> %s\n' "$*"
}

die() {
  printf 'configure-base-system: %s\n' "$*" >&2
  exit 1
}

usage() {
  echo "usage: configure-base-system VARS_FILE [TARGET]" >&2
  exit 2
}

in_target() {
  arch-chroot "$TARGET" "$@"
}

# Install the root-owned files from system/files.txt into the target.
sync_system_files() {
  "$REPO_ROOT/install/sync-system" --root "$TARGET" apply
}

load_config() {
  local vars_file=$1 name
  [[ -r $vars_file ]] || die "cannot read vars file '$vars_file'"

  # shellcheck source-path=SCRIPTDIR source=../system/storage/layout.conf
  source "$REPO_ROOT/system/storage/layout.conf"
  # shellcheck disable=SC1090 # per-install file, chosen at runtime
  source "$vars_file"

  for name in "${REQUIRED_VARS[@]}"; do
    [[ -n ${!name:-} ]] || die "$name is not set in $vars_file"
  done
}

# locale.gen lists every locale commented out, as "#<locale> <charset>".
locale_is_listed() {
  awk -v locale="$LOCALE" '
    { name = $1; sub(/^#/, "", name) }
    name == locale { found = 1 }
    END { exit !found }
  ' "$TARGET/etc/locale.gen"
}

preflight() {
  (($(id -u) == 0)) || die "must run as root"
  mountpoint -q "$TARGET" || die "$TARGET is not mounted"
  mountpoint -q "$TARGET$ESP_MOUNT" || die "$TARGET$ESP_MOUNT is not mounted"
  [[ -s $TARGET/etc/fstab ]] || die "$TARGET/etc/fstab is missing or empty: run pacstrap and genfstab first"
  [[ -e $TARGET/usr/share/zoneinfo/$TZONE ]] || die "unknown timezone '$TZONE'"
  locale_is_listed || die "locale '$LOCALE' is not listed in $TARGET/etc/locale.gen"
}

install_system_files() {
  log "Installing system configuration files"
  sync_system_files
}

# Uncomment exactly the chosen locale; examples and other locales stay commented.
enable_locale() {
  local file="$TARGET/etc/locale.gen" edited
  edited=$(awk -v locale="$LOCALE" '
    { name = $1; sub(/^#/, "", name); if (name == locale) sub(/^#/, "") }
    { print }
  ' "$file")
  printf '%s\n' "$edited" >"$file"
}

configure_identity() {
  log "Setting timezone, locale, keymap, and hostname"
  ln -sf "/usr/share/zoneinfo/$TZONE" "$TARGET/etc/localtime"
  in_target hwclock --systohc
  enable_locale
  in_target locale-gen
  echo "LANG=$LOCALE" >"$TARGET/etc/locale.conf"
  # Written before the UKIs are built: sd-vconsole bakes the keymap into the initramfs.
  echo "KEYMAP=$KEYMAP" >"$TARGET/etc/vconsole.conf"
  echo "$HOST" >"$TARGET/etc/hostname"
}

configure_boot() {
  log "Building unified kernel images and installing systemd-boot"
  local luks_device="/dev/disk/by-partlabel/$LUKS_PARTLABEL" luks_uuid
  luks_uuid=$(blkid -s UUID -o value "$luks_device" || true)
  [[ -n $luks_uuid ]] || die "cannot read the UUID of $luks_device"

  # rootflags names the @ subvolume, the first entry in system/storage/subvolumes.txt.
  local cmdline="rd.luks.name=$luks_uuid=$LUKS_MAPPER root=/dev/mapper/$LUKS_MAPPER rootflags=subvol=@ rw"
  # Hibernation (Phase 12): set only when install-base-system configured a
  # dedicated swap mapper. Baked in explicitly rather than relying on
  # systemd's EFI-variable auto-detect, which has known rough edges on some
  # firmware and isn't needed for a plain partition.
  #
  # resume= alone is not enough (D-0065, a real boot deadlock found on
  # real hardware): systemd-hibernate-resume.service runs *inside the
  # initramfs*, before the real root is even mounted, and binds to the
  # resume device's unit. A device only unlocked later via /etc/crypttab
  # (which lives on the not-yet-mounted real root) can never satisfy
  # that -- a permanent hang, not a slow one (JobTimeoutSec=infinity
  # when resume= comes from the kernel cmdline and no
  # x-systemd.device-timeout is set, hence resumeflags= below too). The
  # swap device needs its own rd.luks.name=, exactly like root already
  # has, so sd-encrypt unlocks it early, inside the initramfs, before
  # systemd-hibernate-resume.service needs it.
  if [[ -n ${SYMPHONY_RESUME_DEVICE:-} ]]; then
    local swap_mapper swap_device swap_uuid
    swap_mapper=$(basename "$SYMPHONY_RESUME_DEVICE")
    swap_device="/dev/disk/by-partlabel/$SWAP_PARTLABEL"
    swap_uuid=$(blkid -s UUID -o value "$swap_device" || true)
    [[ -n $swap_uuid ]] || die "cannot read the UUID of $swap_device"
    cmdline+=" rd.luks.name=$swap_uuid=$swap_mapper resume=$SYMPHONY_RESUME_DEVICE resumeflags=x-systemd.device-timeout=30s"
  fi
  # Firmware quirks chosen by DMI (system/hardware.txt, resolved by install-base-system,
  # D-0076): parameters the kernel enforces itself, e.g. module_blacklist=dell_rbtn. On the
  # command line they reach every unified kernel image, with no initramfs step of their own.
  if [[ -n ${SYMPHONY_KERNEL_PARAMS:-} ]]; then
    cmdline+=" $SYMPHONY_KERNEL_PARAMS"
  fi
  mkdir -p "$TARGET/etc/kernel"
  echo "$cmdline" >"$TARGET/etc/kernel/cmdline"

  # pacstrap built separate initramfs images with the stock presets; UKIs replace them.
  rm -f "$TARGET"/boot/initramfs-*.img
  mkdir -p "$TARGET$ESP_MOUNT/EFI/Linux"
  in_target mkinitcpio -P

  if ! in_target bootctl is-installed >/dev/null 2>&1; then
    in_target bootctl install
  fi
  # bootctl install may write its own default loader.conf; apply again so ours wins.
  sync_system_files
}

create_user() {
  log "Creating user $USERNAME and locking root"
  if ! in_target id -u "$USERNAME" >/dev/null 2>&1; then
    in_target useradd -m -G wheel "$USERNAME"
  fi
  # A new account starts locked (L). Set a usable password (P) if one isn't
  # set yet. fd 8 (see header) lets this run unattended via chpasswd --
  # the standard, non-interactive way to set a Linux password; passwd(1)
  # itself has no such mode on shadow-utils. Without fd 8, falls back to
  # passwd's own interactive prompt, so a mistyped password can still be
  # retried by re-running the script.
  if [[ $(in_target passwd -S "$USERNAME" | awk '{ print $2 }') != P ]]; then
    if [[ -e /dev/fd/8 ]]; then
      local user_password
      read -r user_password <&8
      printf '%s:%s' "$USERNAME" "$user_password" | in_target chpasswd
    else
      in_target passwd "$USERNAME"
    fi
  fi
  in_target passwd -l root
}

# Carries whatever Wi-Fi the live session saved (the installer's Wi-Fi page, or
# nmtui from a shell) to the new system, so the laptop is already connected on
# first boot. The live ISO runs NetworkManager like the installed system does
# (D-0014), so each saved network is already a connection file the new system
# understands: this is a plain copy that knows nothing about the format (that lives
# in gui/installer/wifi.py). Nothing saved is the common case -- the install is
# offline and Wi-Fi is optional -- and is not an error.
#
# 0600 root: NetworkManager silently ignores any connection file other users can
# read (checked against the real daemon).
copy_network_profiles() {
  local profiles=()
  shopt -s nullglob
  profiles=("$LIVE_NM_DIR"/*.nmconnection)
  shopt -u nullglob
  ((${#profiles[@]} > 0)) || return 0

  log "Carrying ${#profiles[@]} saved Wi-Fi connection(s) to the new system"
  local dest="$TARGET/etc/NetworkManager/system-connections" file
  install -d -m 0700 "$dest"
  for file in "${profiles[@]}"; do
    install -m 0600 "$file" "$dest/"
  done
  in_target chown -R root:root /etc/NetworkManager/system-connections
}

# The country for the chosen timezone, from tzdata's zone.tab: tab-separated
# country, coordinates, zone, comment -- one country per zone (zone1970.tab has
# comma lists, so it is not used). Zones with no country, like UTC, have no entry.
regdom_country() {
  awk -F'\t' -v tz="$TZONE" '!/^#/ && $3 == tz { print $1; exit }' \
    "$TARGET/usr/share/zoneinfo/zone.tab" 2>/dev/null || true
}

# Without a regulatory domain the kernel stays in the restrictive "world" domain
# (passive-only scanning on many 5 GHz channels, so networks vanish from the
# list). wireless-regdb ships a udev rule that runs set-wireless-regdom when
# cfg80211 loads; that script sources /etc/conf.d/wireless-regdom and calls
# `iw reg set` -- so the package's own file is the primitive to set, not the kernel
# command line (checked against the real package). The file ships every country
# commented out; any earlier uncommented line is dropped first so a re-run, or a
# changed timezone, never leaves two. Skipped when wireless-regdb isn't there.
configure_regdom() {
  local conf="$TARGET/etc/conf.d/wireless-regdom" country
  if [[ ! -e $conf ]]; then
    log "wireless-regdb is not installed; leaving the regulatory domain unset"
    return 0
  fi
  sed -i '/^WIRELESS_REGDOM=/d' "$conf"
  country=$(regdom_country)
  [[ -n $country ]] || return 0
  log "Setting the wireless regulatory domain to $country"
  echo "WIRELESS_REGDOM=\"$country\"" >>"$conf"
}

# Installs what this machine needs from the repo -- see the header for why it is
# a plain root-owned tree at a fixed path and not a checkout. $REPO_ROOT here is
# the live ISO's own baked-in copy (Phase 14). Without this, install/link-home's
# stow symlinks would point into the live ISO's ephemeral squashfs, broken the
# instant the real system boots. Re-running replaces the whole tree, so it can
# never nest a second copy or keep files a newer payload dropped.
install_payload() {
  log "Installing the symphony payload at $PAYLOAD_DIR"
  local dest="$TARGET$PAYLOAD_DIR" release=unreleased content
  if [[ -r $LIVE_RELEASE_FILE ]]; then
    release=$(<"$LIVE_RELEASE_FILE")
    [[ -n $release ]] || release=unreleased
  fi

  rm -rf "$dest"
  mkdir -p "$dest"
  for content in "${PAYLOAD_CONTENT[@]}"; do
    cp -a "$REPO_ROOT/$content" "$dest/"
  done
  echo "$release" >"$dest/VERSION"
  in_target chown -R root:root "$PAYLOAD_ROOT"
}

# What this machine's hardware needs beyond packages (system/hardware.txt, Phase 19):
# modprobe drop-ins, files such as udev rules, system units. Packages were pacstrapped
# from hwpkglist and the kernel parameters are on the boot line (configure_boot), so
# --no-packages; user units wait for first-login. Runs inside the target as root,
# where sudo is not needed and symphony-hardware knows to skip it.
apply_hardware() {
  log "Applying hardware entries"
  in_target env SYMPHONY_PAYLOAD_DIR="$PAYLOAD_DIR" "$PAYLOAD_DIR/home/hardware/dot-local/bin/symphony-hardware" apply --no-packages
}

# Which directories get created is system/xdg/user-dirs.defaults (installed by
# sync-system, so already in place here); this only runs xdg-user-dirs-update
# once, as the new user, so they exist before first login. HOME is set
# explicitly because runuser -u doesn't necessarily change it inside a chroot.
# LC_ALL=C keeps the names English whatever locale was chosen: the screenshot and
# screen-record scripts fall back to $HOME/Pictures and $HOME/Videos.
create_xdg_dirs() {
  log "Creating $USERNAME's XDG directories"
  in_target runuser -u "$USERNAME" -- env HOME="/home/$USERNAME" LC_ALL=C xdg-user-dirs-update
}

# stow needs no live session, just a writable $HOME -- safe to run here,
# unlike enable_user_services below (see install/first-login).
#
# useradd -m (create_user, above) populates the new home from /etc/skel,
# which ships .bash_logout/.bash_profile/.bashrc -- and home/bash/dot-bashrc
# stows over exactly .bashrc. GNU stow aborts its entire combined call (every
# package, not just bash) on a single conflict like that (reproduced live: a
# real hardware install got this far, crashed here under set -Eeuo pipefail,
# and never reached enable_services() below -- the disk/boot loader/user
# account were already done, so it still booted, just straight to a bare TTY,
# no SDDM). Only .bashrc is removed: .bash_profile is what makes login shells
# (SSH, a TTY) source .bashrc at all, and nothing in home/ replaces it. Safe to
# remove here only: the account was created one step ago and is certain to hold
# nothing but stock skel content. install/link-home itself stays untouched --
# it's also run by hand against already-customized machines (rebuild.md), where
# this same removal would be destructive.
link_home() {
  log "Linking dotfiles for $USERNAME"
  rm -f "$TARGET/home/$USERNAME/.bashrc"
  in_target runuser -u "$USERNAME" -- bash -c "cd $PAYLOAD_DIR && install/link-home apply"
}

# symphony-update takes a pre-update `snapper create`, which fails on a machine
# with no root config, and an ISO install never ran the manual snapper steps.
# Written directly from snapper's own shipped template instead of
# `snapper create-config`, which
# insists on creating its own /.snapshots subvolume: @snapshots is already
# mounted there (system/storage/subvolumes.txt), by design kept out of
# snapshots of /.
configure_snapper() {
  log "Creating snapper's root config"
  local template="$TARGET/usr/share/snapper/config-templates/default"
  [[ -r $template ]] || die "snapper's config template is missing ($template) -- is snapper installed in the target?"

  mkdir -p "$TARGET/etc/snapper/configs"
  sed -E 's/^(TIMELINE_CREATE)=.*/\1="no"/; s/^(NUMBER_LIMIT)=.*/\1="10"/; s/^(NUMBER_LIMIT_IMPORTANT)=.*/\1="10"/' \
    "$template" >"$TARGET/etc/snapper/configs/root"
  sed -i 's/^SNAPPER_CONFIGS=.*/SNAPPER_CONFIGS="root"/' "$TARGET/etc/conf.d/snapper"
  chmod 750 "$TARGET/.snapshots"
}

# system/services-root.txt is the one home of this list (Phase 9); enabling only,
# there's no running systemd inside the target to start anything on.
enable_root_services() {
  log "Enabling root-scope maintenance timers"
  "$ENABLE_ROOT_SERVICES" apply --root "$TARGET"
}

# D-0026 adopted SDDM but deliberately left autologin unconfigured; Phase
# 16 reverses that part of the choice (user confirmed) -- LUKS is already
# the real gate at boot. hyprland-uwsm is the exact session name Hyprland's
# own package ships (confirmed by reading
# /usr/share/wayland-sessions/hyprland-uwsm.desktop directly, not guessed).
configure_autologin() {
  log "Configuring SDDM autologin for $USERNAME"
  mkdir -p "$TARGET/etc/sddm.conf.d"
  cat >"$TARGET/etc/sddm.conf.d/20-autologin.conf" <<EOF
[Autologin]
User=$USERNAME
Session=hyprland-uwsm
EOF
}

# Completes a real, previously half-built feature: the GUI installer's
# Developer Identity page has collected git_name/git_email since Phase 15,
# but nothing ever wrote them anywhere until now. Both optional (GIT_NAME/
# GIT_EMAIL unset when skipped) -- only write the file when both are given.
# ~/.gitconfig.local is the untracked, machine-local half of D-0048's split
# (home/git/dot-gitconfig includes it); never a tracked file, so this never
# touches D-0022's no-identifiers rule.
write_git_identity() {
  [[ -n ${GIT_NAME:-} && -n ${GIT_EMAIL:-} ]] || return 0
  log "Writing git identity for $USERNAME"
  cat >"$TARGET/home/$USERNAME/.gitconfig.local" <<EOF
[user]
	name = "$(gitconfig_escape "$GIT_NAME")"
	email = "$(gitconfig_escape "$GIT_EMAIL")"
EOF
  in_target chown "$USERNAME:$USERNAME" "/home/$USERNAME/.gitconfig.local"
}

# A gitconfig value inside double quotes needs only \ and " escaped; quoting
# also stops a # or ; in a name from starting a comment.
gitconfig_escape() {
  local value=${1//\\/\\\\}
  printf '%s' "${value//\"/\\\"}"
}

enable_services() {
  log "Enabling base services"
  systemctl --root="$TARGET" enable "${SERVICES[@]}"
  # Enabling NetworkManager also links its wait-online service into
  # network-online.target (checked against the real package): anything ordered
  # after the network would then hold boot for up to a minute on a laptop that is
  # simply off Wi-Fi. Masked *after* the enable above -- enabling a masked unit
  # fails.
  systemctl --root="$TARGET" mask NetworkManager-wait-online.service
}

# Last on purpose: arch-chroot bind-mounts the host's resolv.conf over this path
# while it runs.
link_resolv_conf() {
  log "Pointing resolv.conf at the systemd-resolved stub"
  ln -sf ../run/systemd/resolve/stub-resolv.conf "$TARGET/etc/resolv.conf"
}

main() {
  (($# >= 1 && $# <= 2)) || usage
  TARGET=${2:-/mnt}

  load_config "$1"
  preflight

  install_system_files
  configure_identity
  configure_regdom
  copy_network_profiles
  configure_boot
  create_user
  install_payload
  apply_hardware
  create_xdg_dirs
  link_home
  configure_autologin
  write_git_identity
  configure_snapper
  enable_root_services
  enable_services
  link_resolv_conf

  log "Done. Next (runbook step 7): umount -R $TARGET; cryptsetup close $LUKS_MAPPER; poweroff"
}

main "$@"
