#!/usr/bin/env bash
# enable-user-services: enable+start every systemd --user unit declared in
# system/services-user.txt.
#
# Usage: install/enable-user-services check|apply
#   check  report any declared unit that isn't both enabled and active; exit 1
#   apply  enable --now every declared unit (safe to re-run: systemctl's own
#          enable --now is already a no-op on an already-enabled+running unit)
set -euo pipefail

REPO_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
readonly REPO_ROOT
readonly UNITS_FILE="$REPO_ROOT/system/services-user.txt"

usage() {
  echo "usage: enable-user-services check|apply|restart" >&2
  exit 2
}

# One unit name per line; trailing "# why" comments and blank lines stripped --
# the same convention as packages/*.txt, but units aren't packages, so this
# stays its own small parser rather than reusing scripts/pkglist.
units() {
  sed -E 's/#.*//; s/[[:space:]]+$//' "$UNITS_FILE" | grep -Ev '^[[:space:]]*$'
}

check() {
  local unit problems=0
  while IFS= read -r unit; do
    if ! systemctl --user is-enabled --quiet "$unit"; then
      echo "not enabled: $unit"
      problems=$((problems + 1))
    fi
    if ! systemctl --user is-active --quiet "$unit"; then
      echo "not active: $unit"
      problems=$((problems + 1))
    fi
  done < <(units)

  if ((problems > 0)); then
    return 1
  fi
  echo "enabled and active: $(units | wc -l) units"
}

# Keeps going past a failing unit instead of letting set -e abort the loop --
# otherwise one unit that fails to start (say, waybar before the compositor is
# fully up) silently leaves every later unit never enabled. Fails at the end.
apply() {
  local unit failed=()
  while IFS= read -r unit; do
    systemctl --user enable --now "$unit" || failed+=("$unit")
  done < <(units)

  if ((${#failed[@]} > 0)); then
    echo "failed: ${failed[*]}" >&2
    return 1
  fi
  echo "enabled: $(units | tr '\n' ' ')"
}

# What a deploy needs beyond `apply` (#25): `enable --now` is a no-op on a unit that is
# already enabled and running, so a payload that changed waybar's config -- or any unit
# file -- changed nothing on screen. Phase 20's update badge shipped that way and never
# appeared.
#
# daemon-reload first, because systemd otherwise keeps the unit definition it parsed at
# boot; then try-restart, which restarts what is running and starts nothing that is not,
# so a unit stopped on purpose stays stopped and a machine with no session is left alone.
restart() {
  local unit failed=()
  systemctl --user daemon-reload || echo "could not reload the user manager" >&2
  while IFS= read -r unit; do
    systemctl --user try-restart "$unit" || failed+=("$unit")
  done < <(units)

  if ((${#failed[@]} > 0)); then
    echo "failed: ${failed[*]}" >&2
    return 1
  fi
  echo "restarted: $(units | tr '\n' ' ')"
}

main() {
  case ${1:-} in
    check | apply | restart) "$1" ;;
    *) usage ;;
  esac
}

main "$@"
