#!/usr/bin/env bash
# finish-install: unmount and close the encrypted volume, then reboot.
# No prompting, no arguments -- whoever calls this has already decided
# to finish and reboot (run-guided-install's own terminal prompt, or the
# GTK4 GUI's "Reboot" button, Phase 15). Not called at all on "stay at
# the shell" -- that path is just told what to type by hand.
set -euo pipefail

REPO_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
readonly REPO_ROOT

echo "==> Unmounting and closing the encrypted volume..."
umount -R /mnt
# shellcheck source-path=SCRIPTDIR source=../system/storage/layout.conf
source "$REPO_ROOT/system/storage/layout.conf"
cryptsetup close "$LUKS_MAPPER"
echo "==> Rebooting -- remove the USB drive now."
sleep 3
reboot
