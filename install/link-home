#!/usr/bin/env bash
# link-home: link the stow packages under home/ into the home directory.
#
# Usage: install/link-home apply|check
#   apply  stow every package (each directory directly under home/)
#   check  verify every file is linked and no directory is folded; exit 1 otherwise
#
# Packages use stow's --dotfiles naming: home/tmux/dot-tmux.conf becomes ~/.tmux.conf.
# --no-folding makes stow link individual files, never whole directories, so a
# directory like ~/.claude, which also holds credentials, can never become a link into
# this repository.
set -euo pipefail

REPO_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
readonly REPO_ROOT
readonly PACKAGES_DIR="$REPO_ROOT/home"

usage() {
  echo "usage: link-home apply|check" >&2
  exit 2
}

# A fresh home has no wallpaper and no hyprpaper config, and both must exist before
# the first login or the session comes up bare. Neither is stow's to manage:
# current.png is a symlink wallpaper-set repoints to an arbitrary path outside this
# repo, and hyprpaper.conf is generated (D-0085) -- stow would keep restoring its own
# copy over what wallpaper-set writes. Seeded here, once; never overwritten, so a
# machine keeps whatever the user last chose.
seed_wallpaper() {
  local current="$HOME/.local/share/backgrounds/current.png"
  local config="$HOME/.config/hypr/hyprpaper.conf"

  if [[ ! -e $current ]]; then
    mkdir -p "$(dirname "$current")"
    ln -s "$PACKAGES_DIR/hyprpaper/dot-local/share/backgrounds/default.png" "$current"
  fi

  # Points at current.png, not at a resolved image: this runs before any wallpaper has
  # been chosen, and the symlink is the only thing that exists to name. wallpaper-set
  # replaces this with the real path the first time it runs.
  if [[ ! -e $config ]]; then
    mkdir -p "$(dirname "$config")"
    cat >"$config" <<CONF
# Generated by install/link-home for a fresh home (D-0085); wallpaper-set rewrites it
# with the chosen image. Edit the wallpaper, not this file:
#   wallpaper-set <path>    wallpaper-random [dir]    SUPER+CTRL+W
wallpaper {
  monitor = *
  path = $current
  fit_mode = cover
}

ipc = on
splash = false
CONF
  fi
}

apply() {
  local dir names=()
  for dir in "$PACKAGES_DIR"/*/; do
    dir=${dir%/}
    names+=("${dir##*/}")
  done
  # current.png (home/hyprpaper) is deliberately not stow's to manage past its
  # initial checkout: wallpaper-set repoints it to an arbitrary absolute path
  # outside this repo by design (Phase 6), which stow would otherwise (correctly)
  # refuse to restow over -- and since a single combined `stow` call checks every
  # package before changing any of them, that one conflict used to abort every
  # other package's linking too. Ignoring it here lets the rest restow normally
  # regardless of whether wallpaper-set has ever run.
  stow --dir="$PACKAGES_DIR" --target="$HOME" --dotfiles --no-folding --restow \
    --ignore='current\.png$' "${names[@]}"

  seed_wallpaper

  echo "linked: ${names[*]}"
}

# Where stow places a package file: every dot-x path component becomes .x.
home_path() {
  sed -E 's#(^|/)dot-#\1.#g' <<<"$1"
}

check() {
  local file path dir problems=0 total=0 folded=" "
  while IFS= read -r file; do
    total=$((total + 1))
    path=$(home_path "${file#"$PACKAGES_DIR/"*/}")

    # A linked directory on the way to the file means stow folded it into the repo.
    dir=$(dirname "$path")
    while [[ $dir != . ]]; do
      if [[ -L $HOME/$dir && $folded != *" $dir "* ]]; then
        echo "folded: $dir"
        folded+="$dir "
        problems=$((problems + 1))
      fi
      dir=$(dirname "$dir")
    done

    if [[ ! -L $HOME/$path || $(realpath "$HOME/$path") != "$(realpath "$file")" ]]; then
      echo "not linked: $path"
      problems=$((problems + 1))
    fi
  done < <(find "$PACKAGES_DIR" -type f | sort)

  if ((problems > 0)); then
    return 1
  fi
  echo "linked: $total files"
}

main() {
  case ${1:-} in
    apply | check) "$1" ;;
    *) usage ;;
  esac
}

main "$@"
