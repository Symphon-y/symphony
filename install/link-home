#!/usr/bin/env bash
# link-home: link the stow packages under home/ into the home directory.
#
# Usage: install/link-home apply|check
#   apply  stow every package (each directory directly under home/)
#   check  verify every file is linked and no directory is folded; exit 1 otherwise
#
# Packages use stow's --dotfiles naming: home/tmux/dot-tmux.conf becomes ~/.tmux.conf.
# --no-folding makes stow link individual files, never whole directories, so a
# directory like ~/.claude, which also holds credentials, can never become a link into
# this repository.
set -euo pipefail

REPO_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
readonly REPO_ROOT
readonly PACKAGES_DIR="$REPO_ROOT/home"
# shellcheck source-path=SCRIPTDIR source=../scripts/lib/wallpaper.bash
source "$REPO_ROOT/scripts/lib/wallpaper.bash"

usage() {
  echo "usage: link-home apply|check" >&2
  exit 2
}

# A fresh home has no wallpaper library, no pointer and no hyprpaper config, and all
# three must exist before the first login or the session comes up bare and SUPER+CTRL+W
# has nothing to choose. None is stow's to manage: the library is the user's, the
# pointer is a symlink wallpaper-set repoints to an arbitrary path outside this repo,
# and hyprpaper.conf is generated (D-0085) -- stow would keep restoring its own copy
# over what wallpaper-set writes. Seeded here, once; never overwritten, so a machine
# keeps whatever the user last chose.
seed_wallpaper() {
  local default="$PACKAGES_DIR/hyprpaper/dot-local/share/symphony/default-wallpaper.png"
  local library pointer
  library=$(wallpaper_library)
  pointer=$(wallpaper_pointer)
  local config="$HOME/.config/hypr/hyprpaper.conf"

  mkdir -p "$library"
  [[ -e $library/symphony-default.png ]] || ln -s "$default" "$library/symphony-default.png"

  if [[ ! -e $pointer ]]; then
    mkdir -p "$(dirname "$pointer")"
    ln -s "$default" "$pointer"
  fi

  # Points at the pointer, not at a resolved image: this runs before any wallpaper has
  # been chosen, and the symlink is the only thing that exists to name. wallpaper-set
  # replaces this with the real path the first time it runs.
  if [[ ! -e $config ]]; then
    mkdir -p "$(dirname "$config")"
    hyprpaper_config "$pointer" >"$config"
  fi
}

apply() {
  local dir names=()
  for dir in "$PACKAGES_DIR"/*/; do
    dir=${dir%/}
    names+=("${dir##*/}")
  done
  stow --dir="$PACKAGES_DIR" --target="$HOME" --dotfiles --no-folding --restow \
    "${names[@]}"

  seed_wallpaper

  echo "linked: ${names[*]}"
}

# Where stow places a package file: every dot-x path component becomes .x.
home_path() {
  sed -E 's#(^|/)dot-#\1.#g' <<<"$1"
}

check() {
  local file path dir problems=0 total=0 folded=" "
  while IFS= read -r file; do
    total=$((total + 1))
    path=$(home_path "${file#"$PACKAGES_DIR/"*/}")

    # A linked directory on the way to the file means stow folded it into the repo.
    dir=$(dirname "$path")
    while [[ $dir != . ]]; do
      if [[ -L $HOME/$dir && $folded != *" $dir "* ]]; then
        echo "folded: $dir"
        folded+="$dir "
        problems=$((problems + 1))
      fi
      dir=$(dirname "$dir")
    done

    if [[ ! -L $HOME/$path || $(realpath "$HOME/$path") != "$(realpath "$file")" ]]; then
      echo "not linked: $path"
      problems=$((problems + 1))
    fi
  done < <(find "$PACKAGES_DIR" -type f | sort)

  if ((problems > 0)); then
    return 1
  fi
  echo "linked: $total files"
}

main() {
  case ${1:-} in
    apply | check) "$1" ;;
    *) usage ;;
  esac
}

main "$@"
