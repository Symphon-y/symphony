# Per-install values for docs/runbooks/base-install.md. Sourced by bash.
#
#   cp docs/runbooks/base-install.vars.example base-install.local.vars
#   vim base-install.local.vars
#   source base-install.local.vars
#
# *.local.* files are ignored by Git. These are the only machine- and
# person-specific values in the install; everything else comes from the repo.

DISK=/dev/vda           # target disk. EVERYTHING on it is erased. Confirm with `lsblk`.
HOST=                   # hostname, e.g. autarchy-vm
USERNAME=               # your login name
TZONE=                  # timezone, e.g. America/Chicago (list: ls /usr/share/zoneinfo)
LOCALE=en_US.UTF-8      # system language
KEYMAP=us               # console keyboard layout; the LUKS prompt uses it too

# Optional (Phase 12). Leave blank for zram-only swap (the default, D-0013).
# Set to add a dedicated LUKS2-encrypted swap partition sized for hibernation
# -- size it to this machine's actual RAM (confirm with `free -h`), e.g. 16G.
# Unlocked automatically at boot via a generated keyfile, no extra passphrase.
SWAP_SIZE=
