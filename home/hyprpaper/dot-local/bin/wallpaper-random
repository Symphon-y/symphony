#!/usr/bin/env bash
# Target: ~/.local/bin/wallpaper-random (linked by install/link-home)
#
# Picks a random image from a directory (default: ~/.local/share/backgrounds, where
# the user can drop their own images alongside the generated default) and hands it to
# wallpaper-set.
#
# Symlinks count (`find -L`): the default directory holds nothing else -- default.png
# links into the payload -- so a plain `-type f` found nothing there and SUPER+CTRL+W
# silently did nothing. current.png is skipped by name instead: it is the pointer at
# whatever is showing, not a wallpaper of its own.
#
# The one currently showing is excluded, so a small directory still changes every time:
# with four images a uniform pick repeats about a quarter of the time, which reads as
# "the wallpaper is stuck" rather than as chance. A directory holding only the current
# wallpaper sets it again rather than failing -- re-rendering the palette is harmless.
set -euo pipefail

dir=${1:-"$HOME/.local/share/backgrounds"}

mapfile -t images < <(find -L "$dir" -maxdepth 1 -type f ! -name current.png \
  \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' -o -iname '*.bmp' \) 2>/dev/null)

# Reached from a keybinding as often as from a shell, and a keybinding has nowhere to
# print: say it on screen too, or the key just looks dead (it did).
if [[ ${#images[@]} -eq 0 ]]; then
  echo "wallpaper-random: no images found in $dir" >&2
  command -v notify-send >/dev/null &&
    notify-send -a wallpaper -u normal "No wallpapers found" "Nothing to choose from in $dir"
  exit 1
fi

current=""
[[ -e $HOME/.local/share/backgrounds/current.png ]] &&
  current=$(realpath "$HOME/.local/share/backgrounds/current.png")

if ((${#images[@]} > 1)) && [[ -n $current ]]; then
  mapfile -t candidates < <(printf '%s\n' "${images[@]}" | grep -vxF "$current" || true)
  ((${#candidates[@]})) && images=("${candidates[@]}")
fi

wallpaper-set "${images[RANDOM % ${#images[@]}]}"
