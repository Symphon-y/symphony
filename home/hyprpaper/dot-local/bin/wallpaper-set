#!/usr/bin/env bash
# Target: ~/.local/bin/wallpaper-set (linked by install/link-home)
#
# Sets the wallpaper and re-derives the whole system's palette from it. The wallpaper
# *is* the theme (Phase 6: no named-theme library, just whatever's currently on
# screen) -- every matugen template re-renders here, and hardware that shows the theme
# colour repaints.
#
# How the picture is applied (D-0085): hyprpaper 0.8.4 renders only what its *config*
# declares, resolving that path once at startup. Its runtime IPC is gone -- `hyprctl
# hyprpaper preload` answers "invalid hyprpaper request" and `... wallpaper <mon>,<path>`
# is accepted and silently ignored (probed on the machine; the old string protocol this
# script used until now was verified against an older hyprpaper and stopped working on
# the upgrade, changing the palette but never the picture). So: write the config with
# the real path, then restart the service. The config persists, so the choice survives
# the next login too.
set -euo pipefail

readonly CONFIG="$HOME/.config/hypr/hyprpaper.conf"
readonly CURRENT="$HOME/.local/share/backgrounds/current.png"

if [[ $# -ne 1 ]]; then
  echo "usage: wallpaper-set <path>" >&2
  exit 1
fi

path=$(realpath "$1")
if [[ ! -f $path ]]; then
  echo "wallpaper-set: no such file: $path" >&2
  exit 1
fi

# The one home of hyprpaper's config shape: four settings with exactly one consumer,
# written here and seeded identically by install/link-home for a fresh home.
# `monitor = *` is the config file's own wildcard (the IPC's was different, and is
# moot now). The path is the image itself, never current.png, so hyprpaper's
# `listactive`, this file and the journal all name the same thing.
write_config() {
  mkdir -p "$(dirname "$CONFIG")"
  cat >"$CONFIG" <<CONF
# Generated by wallpaper-set (D-0085) -- edit the wallpaper, not this file:
#   wallpaper-set <path>    wallpaper-random [dir]    SUPER+CTRL+W
wallpaper {
  monitor = *
  path = $1
  fit_mode = cover
}

ipc = on
splash = false
CONF
}

# current.png stays the stable "what is the wallpaper" answer for anything that asks
# without parsing a config -- install/first-login renders the palette from it before
# any service is up.
mkdir -p "$(dirname "$CURRENT")"
ln -sfn "$path" "$CURRENT"

write_config "$path"

# Only when it is running: a TTY login or an install-time run has no hyprpaper to
# restart, and the config is already right for its next start.
if systemctl --user is-active --quiet hyprpaper.service; then
  systemctl --user restart hyprpaper.service
fi

# --source-color-index 0 (most dominant color) skips matugen's interactive
# source-color prompt, which would otherwise hang a keybind-triggered run with no TTY.
matugen --config "$HOME/.config/matugen/config.toml" image "$path" --source-color-index 0

# Hardware that shows the theme colour (AlienFX, Phase 19): repaint from the fresh
# palette. A no-op wherever there is no such hardware; never fails this script.
command -v alienfx-theme >/dev/null && alienfx-theme || true
