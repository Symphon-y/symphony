#!/usr/bin/env bash
# Target: ~/.local/bin/network-menu (linked by install/link-home)
#
# The one entry point for network UI (Phase 17, D-0071). Waybar's Wi-Fi icon and
# SUPER+CTRL+N call this, never the tools directly -- roles, not hardcoded
# executables, so swapping the picker or the settings window later is a one-file
# change. Same shape as power-menu and clipboard-menu.
#
#   network-menu        the network picker: networkmanager-dmenu through fuzzel
#                       (~/.config/networkmanager-dmenu/config.ini), then network-watch
#                       reports whether the connection worked (D-0075) -- the picker
#                       itself exits as soon as NetworkManager accepts the request
#   network-menu edit   full network settings: nm-connection-editor -- hidden
#                       networks, VPN, static addresses, 802.1X, which the picker
#                       does not do
set -euo pipefail

usage() {
  echo "usage: network-menu [edit]" >&2
  exit 2
}

# The picker, then the watcher. The watcher needs the profiles that existed before, to
# tell what this attempt created; if they can't be listed it is skipped, because an empty
# list would make every saved profile look new.
pick() {
  local before status=0 watch=1
  before=$(nmcli -t -f UUID connection show 2>/dev/null) || watch=0

  networkmanager_dmenu || status=$?
  if ((watch)); then
    printf '%s\n' "$before" | network-watch
  fi
  return "$status"
}

case ${1:-} in
  "") pick ;;
  edit) exec nm-connection-editor ;;
  *) usage ;;
esac
