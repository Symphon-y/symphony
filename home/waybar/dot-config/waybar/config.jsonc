// Target: ~/.config/waybar/config.jsonc (linked by install/link-home)
//
// A minimal, non-cluttered bar: workspaces, clock, updates, volume, network, battery, tray.
// Colors come from ~/.config/waybar/colors.css (matugen-generated, imported by
// style.css) -- this file only defines structure.
{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 4,

  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["custom/update", "wireplumber", "network", "battery", "tray"],

  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "",
      "default": ""
    }
  },

  "clock": {
    "format": "{:%H:%M  %Y-%m-%d}",
    "tooltip-format": "{:%A, %d %B %Y}"
  },

  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "muted",
    "format-icons": ["", "", ""],
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },

  // Signal strength as one of five icons (weakest to strongest), plus a distinct icon
  // for cable, cable-without-an-address, not connected, and radio off (rfkill). The
  // name and details are in the tooltip. Click opens the network picker, right-click
  // the full settings (Phase 17): both go through network-menu, never the tools.
  "network": {
    "interval": 5,
    "format-wifi": "{icon}",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format-ethernet": "󰈀",
    "format-linked": "󰈂",
    "format-disconnected": "󰤮",
    "format-disabled": "󰤭",
    "tooltip-format-wifi": "{essid}  {signalStrength}%  {frequency} GHz\n{ipaddr}/{cidr}",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}/{cidr}",
    "tooltip-format-linked": "{ifname}: linked, waiting for an address",
    "tooltip-format-disconnected": "Not connected -- click to choose a network",
    "tooltip-format-disabled": "Wi-Fi is off -- click to open the network menu",
    "on-click": "network-menu",
    "on-click-right": "network-menu edit"
  },

  // For the laptop. Waybar shows nothing when there is no battery (a desktop VM).
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "{timeTo}"
  },

  // Present only when something is pending: update-status prints nothing otherwise, and
  // waybar hides a custom module with no text. The state file it reads is written by
  // update-check on a timer, so this poll costs nothing and never touches the network
  // (Phase 20, D-0087). Click applies everything pending, right-click re-checks now.
  "custom/update": {
    "exec": "update-status",
    "return-type": "json",
    "interval": 300,
    "on-click": "systemd-run --user --scope --collect --quiet xdg-terminal-exec -- update-now",
    "on-click-right": "systemctl --user start update-notify.service"
  },

  "tray": {
    "spacing": 8
  }
}
