#!/usr/bin/env bash
# Target: ~/.local/bin/update-notify (linked by install/link-home)
#
# update-notify: say once, on the desktop, that something is pending -- and offer to do
# it (Phase 9 D-0059 for packages, Phase 18 for releases, made actionable in Phase 20,
# D-0087).
#
# Reads only what update-check wrote. It asks nothing itself: one script checks, this
# one speaks, update-now acts.
#
# Applies nothing on its own. Unattended `-Syu` risks a partial upgrade, the well-known
# Arch anti-pattern, and an OS update is the user's call -- so the update happens when
# the action is chosen, in a terminal, where it can be watched and a password asked for.
#
# One toast per new thing: a marker holds the release tag and the package set already
# announced, so the same pending updates do not nag every day.
set -uo pipefail

ROOT=$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../../../.." && pwd)
readonly ROOT
# shellcheck source-path=SCRIPTDIR source=../../../../scripts/lib/updates.bash
source "$ROOT/scripts/lib/updates.bash"

readonly STATE_DIR="${SYMPHONY_STATE:-$HOME/.local/state/symphony}"
readonly MARKER="$STATE_DIR/updates-notified"
# Long enough to read and click, short enough that --wait cannot hold the timer's
# oneshot service open all day. The waybar badge is what persists.
readonly TOAST_MS=30000

updates_load
updates_pending || exit 0

announcement="release=$UPDATE_RELEASE pkglist=$UPDATE_PKGLIST"
[[ -r $MARKER && $(<"$MARKER") == "$announcement" ]] && exit 0

plural=$([[ $UPDATE_PACKAGES -eq 1 ]] && echo update || echo updates)

if [[ -n $UPDATE_RELEASE ]]; then
  summary="symphony $UPDATE_RELEASE available"
else
  summary="$UPDATE_PACKAGES $plural available"
fi

body=""
[[ -n $UPDATE_RELEASE ]] && body="Installed: $UPDATE_INSTALLED."
if ((UPDATE_PACKAGES > 0)); then
  [[ -n $body ]] && body+=" "
  body+="$UPDATE_PACKAGES package $plural pending: $(updates_pkglist_summary "$UPDATE_PKGLIST" 8)."
fi

mkdir -p "$STATE_DIR"
echo "$announcement" >"$MARKER"

# --action implies --wait: notify-send blocks until the toast is answered or expires,
# and prints the chosen action's name.
action=$(notify-send --app-name=symphony -t "$TOAST_MS" \
  -A update="Update now" -A later="Later" \
  "$summary" "$body")

[[ $action == update ]] || exit 0

# Detached on purpose: this runs from a Type=oneshot unit, which takes its whole cgroup
# down when ExecStart returns -- the terminal would die with it, mid-update.
systemd-run --user --scope --collect --quiet xdg-terminal-exec -- update-now
