# Generated by matugen from ~/.config/matugen/config.toml into
# ~/.config/symphony/theme.env: the palette's key colours as shell variables, for
# scripts that are not themselves templated (alienfx-theme, Phase 19). Edit this
# template, not the generated file -- it gets overwritten on every render.
PRIMARY={{ colors.primary.default.hex }}
ON_PRIMARY={{ colors.on_primary.default.hex }}
BACKGROUND={{ colors.background.default.hex }}
ON_BACKGROUND={{ colors.on_background.default.hex }}
ERROR={{ colors.error.default.hex }}
