#!/usr/bin/env bash
# Target: ~/.local/bin/alienfx-theme (linked by install/link-home)
#
# alienfx-theme: paint every AlienFX zone in the theme's primary colour (Phase 19,
# D-0084). The colour is the palette matugen rendered from the wallpaper
# (~/.config/symphony/theme.env, one home for it); the tool is alienfx, driving the
# USB HID controller. Writes ~/.config/alienfx/symphony.json -- the tool's own theme
# format, every power state the same fixed colour -- and applies it.
#
# Quiet by design where it does not apply: no colour yet (first login before the
# first render), no alienfx (a machine without the controller never gets the
# package), or the tool failing (device unplugged, no access) -- the caller
# (wallpaper-set, the login unit) must never fail because of lighting.
set -euo pipefail

readonly THEME_ENV="$HOME/.config/symphony/theme.env"
readonly THEME_DIR="$HOME/.config/alienfx"
readonly THEME="$THEME_DIR/symphony.json"

[[ -r $THEME_ENV ]] || exit 0
command -v alienfx >/dev/null || exit 0

# Is the controller there, and can this user talk to it? alienfx itself retries an
# inaccessible device forever, one error line per packet, so the check is made here:
# one line, once. Absent device: nothing to do. Present but not writable: the udev
# rule (system/hardware/60-alienfx.rules) has not been applied to it yet.
readonly SYS="${SYMPHONY_SYS:-/sys}" DEV="${SYMPHONY_DEV:-/dev}"
node=""
for d in "$SYS"/bus/usb/devices/*; do
  [[ -r $d/idVendor && $(<"$d/idVendor") == 187c && $(<"$d/idProduct") == 0525 ]] || continue
  node=$(printf '%s/bus/usb/%03d/%03d' "$DEV" "$(<"$d/busnum")" "$(<"$d/devnum")")
  break
done
[[ -n $node ]] || exit 0
if [[ ! -w $node ]]; then
  echo "alienfx-theme: the AlienFX controller at $node is not writable by $USER -- is the udev rule applied? (symphony-hardware apply)" >&2
  exit 0
fi

primary=$(sed -n 's/^PRIMARY=#\?\([0-9A-Fa-f]\{6\}\).*/\1/p' "$THEME_ENV" | head -n1)
[[ -n $primary ]] || exit 0

r=$((16#${primary:0:2}))
g=$((16#${primary:2:2}))
b=$((16#${primary:4:2}))

# Remove the white floor. Material You's dark-scheme primaries are pastels -- this
# palette's amber #f9bb72 has 114 of 255 in its lowest channel -- and an LED with 16
# levels behind a diffuser renders that floor as a pale wash: on the Alienware the
# amber came out pink while hyprlock's outline (same colour, a real display) read gold.
# Stretching each channel so the lowest reaches zero keeps the hue and the brightness
# and drops the wash; a grey palette (a monochrome wallpaper) has no hue to keep and
# stays grey. A display-space correction, like gamma -- the palette is still the one
# source of truth (D-0084).
low=$r
((g < low)) && low=$g
((b < low)) && low=$b
high=$r
((g > high)) && high=$g
((b > high)) && high=$b
if ((high > low)); then
  r=$(((r - low) * high / (high - low)))
  g=$(((g - low) * high / (high - low)))
  b=$(((b - low) * high / (high - low)))
fi

# The controller takes 4 bits per channel (0-15); the palette gives 8. Rounded,
# not truncated: 255 -> 15 either way, but 0xa7 is nearer 10 than 9.
r=$(((r + 8) / 17))
g=$(((g + 8) / 17))
b=$(((b + 8) / 17))

# The Alienware 14's zones, as verified by zonescan (packages/aur/alienfx's patch).
zones='["Left Keyboard", "Middle-left Keyboard", "Middle-right Keyboard", "Right Keyboard", "Alien Head", "Logo", "Touchpad", "Status LEDs"]'
block="{\"zones\": $zones, \"loop\": [{\"type\": \"fixed\", \"colours\": [[$r, $g, $b]]}]}"

mkdir -p "$THEME_DIR"
{
  echo '{'
  echo '  "speed": 200,'
  local_states=("Boot" "AC Sleep" "AC Charged" "AC Charging" "Battery Sleep" "Battery On" "Battery Critical")
  for i in "${!local_states[@]}"; do
    sep=","
    ((i == ${#local_states[@]} - 1)) && sep=""
    echo "  \"${local_states[$i]}\": [$block]$sep"
  done
  echo '}'
} >"$THEME"

alienfx --theme symphony || echo "alienfx-theme: alienfx failed (no device, or no access?)" >&2
exit 0
