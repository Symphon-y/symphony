#!/usr/bin/env bash
# autarchy-bootstrap: get the autarchy repo onto a booted release ISO, pinned
# to the exact tag this ISO was built from.
#
# Replaces base-install.md's old runbook step 1 (pacman -Sy git github-cli,
# then gh auth login, then gh repo clone typed by hand) with one command --
# git and github-cli are already in this ISO's packages.x86_64, so only the
# auth handshake and the clone are left. `gh auth login --web` is a real
# device-code flow and stays interactive on purpose: no credential is baked
# into the ISO.
set -euo pipefail

readonly RELEASE_FILE=/etc/autarchy-release
readonly CLONE_DIR=/root/autarchy

die() {
  printf 'autarchy-bootstrap: %s\n' "$*" >&2
  exit 1
}

[[ -r $RELEASE_FILE ]] || die "$RELEASE_FILE is missing"
release=$(<"$RELEASE_FILE")
[[ -n $release && $release != unreleased ]] ||
  die "this ISO was not built by the release workflow ($RELEASE_FILE says '$release')"

if [[ -d $CLONE_DIR ]]; then
  echo "autarchy-bootstrap: $CLONE_DIR already exists, skipping clone"
else
  gh auth login --hostname github.com --git-protocol https --web
  gh auth setup-git
  gh repo clone Symphon-y/autarchy "$CLONE_DIR" -- --branch "$release"
fi

cat <<EOF

Cloned autarchy @ $release into $CLONE_DIR.

Next (base-install.md step 1 continued):
  cd $CLONE_DIR
  git config --global user.name  "<your name>"
  git config --global user.email "<your email>"
  cp docs/runbooks/base-install.vars.example base-install.local.vars
  vim base-install.local.vars
  source base-install.local.vars
EOF
