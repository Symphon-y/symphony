#!/usr/bin/env bash
# autarchy-install: the terminal collector -- the boot fallback / manual-
# recovery path (Phase 15's GTK4 GUI is the primary one; this stays as
# the collector of last resort, not replaced). The repo is already baked
# into the live environment at build time (Phase 14) -- no clone, no
# GitHub access needed. Shows ground truth, asks a handful of plain
# questions in a fixed order (including the LUKS passphrase, typed twice
# -- Phase 15/D-0066), shows a review screen, then hands off to
# install/run-guided-install, the shared runner both this script and the
# future GUI use, so neither has to reimplement "run the install, then
# offer to reboot." No install logic lives here -- see Phase 12's plan
# (docs/phases/phase-12-alienware-migration.md) for why: a linear
# sequential flow ending in one review screen, not a free-navigation
# menu, researched against archinstall/Calamares/Windows Setup precedent
# before being designed. The destructive-action confirmation stays
# entirely in install-base-system's own typed-disk-path gate -- this
# script's review screen is a separate, lighter "did I answer these
# right" checkpoint, not a replacement for it.
set -euo pipefail

readonly CLONE_DIR=/root/autarchy
readonly VARS_FILE="$CLONE_DIR/base-install.local.vars"

log() {
  printf '==> %s\n' "$*"
}

# ask PROMPT [DEFAULT] -> the entered value, or DEFAULT if given and the
# reply was empty.
ask() {
  local prompt=$1 default=${2:-} reply
  if [[ -n $default ]]; then
    read -rp "$prompt [$default]: " reply
    printf '%s' "${reply:-$default}"
  else
    read -rp "$prompt: " reply
    printf '%s' "$reply"
  fi
}

# ask_password PROMPT -> the entered value on stdout, after typing it
# twice (silently, no echo -- read -rs) and confirming they match. Used
# for the LUKS passphrase so the whole install stays unattended after
# the review-screen confirm, instead of cryptsetup prompting mid-run
# (Phase 15/D-0066).
ask_password() {
  local prompt=$1 first second
  while true; do
    read -rsp "$prompt: " first
    echo >&2
    if [[ -z $first ]]; then
      echo "Enter a password." >&2
      continue
    fi
    read -rsp "Confirm $prompt: " second
    echo >&2
    if [[ $first != "$second" ]]; then
      echo "Didn't match -- try again." >&2
      continue
    fi
    printf '%s' "$first"
    return
  done
}

# boot_disk -> the whole disk the live medium itself is booted from, if it
# can be identified (empty otherwise -- a best-effort label, not a hard
# block). /run/archiso/bootmnt is archiso's own mount point for the actual
# boot device.
boot_disk() {
  lsblk -no PKNAME "$(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null)" 2>/dev/null || true
}

# list_disks: prints every whole disk (name, size, model) to stderr, one per
# line, labeling the live medium's own disk when identifiable.
list_disks() {
  local boot
  boot=$(boot_disk)
  lsblk -dno NAME,SIZE,MODEL,TYPE | awk -v boot="$boot" '
    $NF == "disk" {
      name = $1
      label = (name == boot) ? "  (installer media -- do not select)" : ""
      $1 = ""; $NF = ""
      print "  /dev/" name "  " $0 label
    }' >&2
}

# ask_disk -> the validated target disk path on stdout. Lists every
# candidate disk first -- there was previously no way to know the options
# -- and defaults to the one non-installer-media disk when there's exactly
# one, closer to a GUI installer's "everything else is picked for you"
# feel even inside a terminal prompt (a real TUI is Phase 15's job).
# Loops instead of accepting a blank or invalid value: previously a blank
# answer here silently made it all the way into install-base-system before
# surfacing as an unhelpful, unrelated-looking error.
ask_disk() {
  local boot disk reply default="" candidates=() name

  echo >&2
  log "Available disks:" >&2
  list_disks
  boot=$(boot_disk)

  while read -r name; do
    [[ $name == "$boot" ]] || candidates+=("/dev/$name")
  done < <(lsblk -dno NAME,TYPE | awk '$2 == "disk" {print $1}')
  ((${#candidates[@]} == 1)) && default=${candidates[0]}

  while true; do
    if [[ -n $default ]]; then
      read -rp "Target disk [$default] -- EVERYTHING on it will be erased: " reply
      reply=${reply:-$default}
    else
      read -rp "Target disk (e.g. /dev/sda) -- EVERYTHING on it will be erased: " reply
    fi
    if [[ -z $reply ]]; then
      echo "Enter one of the disk paths listed above." >&2
      continue
    fi
    if [[ $(lsblk -dno TYPE "$reply" 2>/dev/null) != disk ]]; then
      echo "'$reply' is not one of the disks listed above." >&2
      continue
    fi
    disk=$reply
    break
  done
  printf '%s' "$disk"
}

main() {
  cd "$CLONE_DIR"

  echo
  log "Gathering ground truth about this machine..."
  echo
  scripts/system-report || true

  echo
  log "A few questions, then this runs unattended."
  local disk host username tzone locale keymap swap_size passphrase
  disk=$(ask_disk)
  host=$(ask "Hostname")
  username=$(ask "Username")
  tzone=$(ask "Timezone (e.g. America/Chicago; list: ls /usr/share/zoneinfo)")
  locale=$(ask "Locale" "en_US.UTF-8")
  keymap=$(ask "Console keymap" "us")
  swap_size=$(ask "Hibernation swap size (blank to skip, e.g. 16G -- see Memory above)")
  passphrase=$(ask_password "Disk encryption passphrase")

  echo
  log "Review:"
  cat <<SUMMARY
    Disk:        $disk   (EVERYTHING on this disk will be erased)
    Hostname:    $host
    Username:    $username
    Timezone:    $tzone
    Locale:      $locale
    Keymap:      $keymap
    Hibernation: ${swap_size:-none}
    Encryption:  passphrase set
SUMMARY
  echo
  local confirm
  read -rp "Proceed with these values? [y/N] " confirm
  [[ $confirm =~ ^[Yy]$ ]] || {
    echo "Aborted -- nothing was changed."
    exit 1
  }

  cat >"$VARS_FILE" <<EOF
DISK=$disk
HOST=$host
USERNAME=$username
TZONE=$tzone
LOCALE=$locale
KEYMAP=$keymap
SWAP_SIZE=$swap_size
EOF

  install/run-guided-install "$VARS_FILE" 9<<<"$passphrase"
}

main "$@"
