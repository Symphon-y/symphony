# Packages baked into the live/install environment itself -- deliberately
# thin. This is a network installer, not an offline/desktop-preloaded image
# (Phase 10 scope): the desktop stack and everything else in packages/*.txt
# still comes from pacstrap at install time, exactly as base-install.md
# already does. No AUR packages here -- archiso can't build them, and this
# project doesn't run a custom repo/mirror to work around that (D-0050).
#
# One bare package name per line: mkarchiso reads this file directly (not
# through scripts/pkglist), and only understands whole-line '#' comments --
# no trailing inline comments, unlike this project's own packages/*.txt
# convention. Found the hard way: a trailing inline comment on a package
# line becomes part of the package name, and mkarchiso fails with
# "target not found: <name><trailing whitespace>".

# Boot-critical: without these the ISO doesn't boot as a live environment at all.
base
linux
linux-firmware
mkinitcpio
mkinitcpio-archiso
# microcode; hardware unknown until first boot (base-install.md step 2)
intel-ucode
amd-ucode

# Disk layout tools (base-install.md steps 4-5: partition, LUKS, Btrfs, ESP)
# sgdisk
gptfdisk
cryptsetup
btrfs-progs
# mkfs.fat for the ESP
dosfstools
# pacstrap, genfstab, arch-chroot
arch-install-scripts
efibootmgr

# Network: wired and wireless, so the live environment can reach GitHub and
# the pacman mirrors regardless of connection type.
dhcpcd
iwd
systemd-resolvconf

# Repo access (replaces today's manual `pacman -Sy git github-cli` -- runbook
# step 1) and the test runner for the Red step (runbook step 3).
git
github-cli
bats
bats-assert
bats-support

# Editing the vars file (base-install.md step 1: `vim base-install.local.vars`)
# and a usable text console.
vim
tmux
sudo
