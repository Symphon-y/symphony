# Secrets — never commit (D-0003)
.env
.env.*
*.key
*.pem
*.age
secrets/
*.secret

# Machine-local overrides stay out of portable config
*.local
*.local.*
# Per-machine package lists (scripts/pkg-audit): what one machine has on purpose
# that the ISO never ships
/packages/local/

# Claude Code per-user settings
.claude/settings.local.json

# Generated at release-ISO build time (Phase 13): the local package repo
# baked into the offline installer, never committed -- large binary
# .pkg.tar.zst files and repo databases, regenerated fresh by CI every build.
/iso/profile/airootfs/var/lib/symphony-repo/

# Editors and OS noise
.DS_Store
*.swp
*.swo
*~
.idea/
.vscode/

# Python bytecode cache (gui/, Phase 15)
__pycache__/
*.pyc

# Local ISO builds (scripts/build-iso): multi-gigabyte, never committed
/out/
